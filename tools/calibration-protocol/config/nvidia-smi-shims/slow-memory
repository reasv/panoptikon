#!/bin/sh
# Only the ledger's free-memory refresh
# (`--query-gpu=uuid,memory.total,memory.free`) is slow, so the boot inventory
# still succeeds and there IS a GPU to refresh. This is the shape that
# exercises a wedged nvidia-smi under load and the load path's synchronous
# probe. Same environment variables as `slow-all`.
echo "$(date -u +%FT%T.%3NZ) start $*" >> "${SMI_SHIM_LOG:-/dev/null}"
case "$*" in
  *memory.free*) sleep "${SMI_SHIM_DELAY:-6}" ;;
esac
"${SMI_SHIM_REAL:-/usr/bin/nvidia-smi}" "$@"
rc=$?
echo "$(date -u +%FT%T.%3NZ) end rc=$rc $*" >> "${SMI_SHIM_LOG:-/dev/null}"
exit $rc
