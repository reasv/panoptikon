#!/usr/bin/env bash
# Pre-push: refuse to push a broken UI pin (rev + NAR hash vs ui gitlink).
# Validates the **committed tip** (HEAD), not a dirty worktree.
# npm is not pinned here (importNpmLock). Enable: core.hooksPath scripts/git-hooks
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"
# shellcheck source=common.sh
source "$(dirname "$0")/common.sh"

[[ -f $SYNC_SCRIPT ]] || exit 0

# Skip when this branch tip has no ui gitlink.
if [[ -z $(ui_gitlink_rev HEAD) ]]; then
  exit 0
fi

echo "pre-push: verifying ui-pin.json at HEAD …"
if ! py "$SYNC_SCRIPT" --check --ref HEAD --quiet; then
  echo "pre-push: error: ui-pin.json at HEAD is out of date or wrong" >&2
  echo "pre-push: (worktree-only fixes do not count — commit the pin)" >&2
  echo "pre-push: fix: python3 $SYNC_SCRIPT && git add $PIN_PATH && git commit" >&2
  exit 1
fi
echo "pre-push: ui-pin.json OK at HEAD"
